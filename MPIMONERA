    function initDndGame() {
      cardPlacements = {};
      selectedTouchCardId = null;
      document.getElementById('dndFeedbackBox').classList.remove('show');
      document.getElementById('dndScoreBadge').textContent = '';

      const shuffled = [...classificationCards].sort(() => Math.random() - 0.5);
      shuffled.forEach(c => { cardPlacements[c.id] = 'pool'; });
      renderDndBoard(false);
    }

    function renderDndBoard(showValidation) {
      const poolEl = document.getElementById('dndCardPool');
      const archEl = document.getElementById('zone-archaea');
      const euEl = document.getElementById('zone-eubacteria');

      poolEl.innerHTML = '';
      archEl.innerHTML = '';
      euEl.innerHTML = '';

      classificationCards.forEach(c => {
        const place = cardPlacements[c.id];
        const cardDiv = document.createElement('div');
        cardDiv.className = 'dnd-card';
        if (selectedTouchCardId === c.id) cardDiv.classList.add('selected-touch');
        if (showValidation && place !== 'pool') {
          cardDiv.classList.add(place === c.group ? 'correct' : 'wrong');
        }
        cardDiv.draggable = true;
        cardDiv.id = 'dnd-' + c.id;
        cardDiv.innerHTML = `<strong>${c.label}</strong><div style="font-size:0.78rem; color:var(--text-muted); margin-top:2px;">${c.desc}</div>`;

        // Drag events (Desktop Mouse)
        cardDiv.addEventListener('dragstart', (e) => {
          e.dataTransfer.setData('text/plain', c.id);
        });

        // Tap/Click event (Mobile Touch & Aksesibilitas)
        cardDiv.addEventListener('click', (e) => {
          e.stopPropagation();
          selectedTouchCardId = (selectedTouchCardId === c.id) ? null : c.id;
          renderDndBoard(false);
        });

        if (place === 'pool') poolEl.appendChild(cardDiv);
        else if (place === 'archaea') archEl.appendChild(cardDiv);
        else if (place === 'eubacteria') euEl.appendChild(cardDiv);
      });
    }

    function allowDrop(e) {
      e.preventDefault();
      if (e.currentTarget.classList.contains('dropzone')) {
        e.currentTarget.classList.add('drag-over');
      }
    }

    function leaveDrop(e) {
      e.currentTarget.classList.remove('drag-over');
    }

    function dropCard(e, targetZone) {
      e.preventDefault();
      e.currentTarget.classList.remove('drag-over');
      const cardId = e.dataTransfer.getData('text/plain');
      if (cardId && cardPlacements[cardId] !== undefined) {
        cardPlacements[cardId] = targetZone;
        selectedTouchCardId = null;
        renderDndBoard(false);
      }
    }

    function tapZone(targetZone) {
      if (selectedTouchCardId) {
        cardPlacements[selectedTouchCardId] = targetZone;
        selectedTouchCardId = null;
        renderDndBoard(false);
      }
    }

    function verifyClassification() {
      let placedCount = 0;
      let correctCount = 0;

      classificationCards.forEach(c => {
        const place = cardPlacements[c.id];
        if (place !== 'pool') placedCount++;
        if (place === c.group) correctCount++;
      });

      const fb = document.getElementById('dndFeedbackBox');
      if (placedCount < classificationCards.length) {
        fb.className = 'feedback-box feedback-error show';
        fb.innerHTML = `Masih ada <strong>${classificationCards.length - placedCount} kartu</strong> di kolam atas yang belum dikelompokkan. Pindahkan semua kartu terlebih dahulu!`;
        return;
      }

      renderDndBoard(true);
      const scorePct = Math.round((correctCount / classificationCards.length) * 100);
      document.getElementById('dndScoreBadge').textContent = `Skor Klasifikasi: ${correctCount}/${classificationCards.length} (${scorePct}%)`;

      if (correctCount === classificationCards.length) {
        fb.className = 'feedback-box feedback-success show';
        fb.innerHTML = '<strong>Hebat! Semua Kartu Terklasifikasi dengan Benar (100%)!</strong><br>Kamu berhasil membedakan kelompok ekstremofilik <em>Archaebacteria</em> (Metanogen, Halofil ekstrem, Termoasidofil) dengan bakteri sejati <em>Eubacteria</em> (<em>E. coli, Rhizobium, Nostoc, Lactobacillus</em>).';
        appState.completedModules.mod5 = true;
        saveState();
      } else {
        fb.className = 'feedback-box feedback-error show';
        fb.innerHTML = `<strong>Hasil Verifikasi: ${correctCount} dari ${classificationCards.length} kartu benar.</strong> Kartu berbingkai merah masih keliru tempat. Ingat: bakteri penghuni rawa metana, kadar garam pekat, dan kawah panas tergolong <em>Archaebacteria</em>!`;
      }
    }

