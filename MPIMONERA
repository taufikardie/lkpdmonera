    function saveState() {
      try {
        if (window.localStorage) {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
        }
      } catch (e) {
        // Fallback diam-diam jika mode incognito / file:// membatasi localStorage
      }
      updateProgressUI();
    }

    function loadState() {
      try {
        if (window.localStorage) {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            appState = Object.assign(appState, parsed);
          }
        }
      } catch (e) {
        // Tetap berjalan menggunakan state memori default
      }
      if (appState.studentName) {
        document.getElementById('studentNameInput').value = appState.studentName;
        document.getElementById('headerStudentName').textContent = 'Peserta Didik: ' + appState.studentName;
      }
      updateProgressUI();
    }

    function updateProgressUI() {
      const keys = Object.keys(appState.completedModules);
      let doneCount = 0;
      keys.forEach(k => {
        const dot = document.getElementById('dot-' + k);
        if (appState.completedModules[k]) {
          doneCount++;
          if (dot) dot.classList.add('done');
        } else {
          if (dot) dot.classList.remove('done');
        }
      });
      const pct = Math.round((doneCount / keys.length) * 100);
      document.getElementById('globalProgressFill').style.width = pct + '%';
      document.getElementById('globalProgressText').textContent = pct + '% (' + doneCount + '/' + keys.length + ' Bagian)';
    }

