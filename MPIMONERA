    function checkShapeMatching() {
      let correct = 0;
      currentShapeQuestions.forEach((item, idx) => {
        const sel = document.getElementById('matchShapeSel-' + idx);
        if (sel && sel.value === item.id) {
          correct++;
          sel.style.borderColor = 'var(--success)';
        } else if (sel) {
          sel.style.borderColor = 'var(--danger)';
        }
      });

      const fb = document.getElementById('shapeMatchFeedback');
      if (correct === 4) {
        fb.className = 'feedback-box feedback-success show';
        fb.innerHTML = '<strong>Sempurna (4/4 Benar)!</strong> Kamu telah menguasai identifikasi bentuk dan susunan koloni bakteri.';
