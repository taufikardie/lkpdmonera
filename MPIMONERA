      binerTimer = setInterval(() => {
        binerStep = (binerStep + 1) % binerStages.length;
        renderBinerStage();
      }, 1700);
    }

    function pauseBinerAnim() {
      if (binerTimer) {
        clearInterval(binerTimer);
        binerTimer = null;
      }
