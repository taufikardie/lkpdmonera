    function updatePopulationCalc() {
      const n0 = parseInt(document.getElementById('sliderN0').value, 10);
      const gen = parseInt(document.getElementById('sliderGen').value, 10);
      const total = n0 * Math.pow(2, gen);

      document.getElementById('valN0').textContent = n0;
      document.getElementById('valGen').textContent = gen;
      document.getElementById('valMinutes').textContent = gen * 20;

      document.getElementById('populationFormulaDisplay').innerHTML =
        `N = N&#8320; &times; 2<sup>n</sup> = ${n0} &times; 2<sup>${gen}</sup> = <span style="color:var(--primary-dark); font-size:1.2rem;">${total.toLocaleString('id-ID')} Sel Bakteri</span>`;

      const visualCount = Math.min(total, 128);
      let dots = '';
      for (let i = 0; i < visualCount; i++) {
        dots += `<span title="Sel Bakteri" style="display:inline-block; width:16px; height:9px; border-radius:99px; background:linear-gradient(90deg,#10b981,#059669); border:1px solid #064e3b;"></span>`;
      }
      if (total > 128) {
        dots += `<span style="font-size:0.8rem; color:var(--text-muted); margin-left:6px;">... (+${(total - 128).toLocaleString('id-ID')} sel lainnya)</span>`;
      }
      document.getElementById('colonyVisualGrid').innerHTML = dots;
    }

