<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jelajah Dunia Monera - Biologi Kelas X | SMAN 2 Tanjung Raja</title>
  <style>
    /* ==========================================================================
       VARIABEL WARNA, TIPOGRAFI, DAN RESET DASAR (100% OFFLINE CSS3)
       ========================================================================== */
    :root {
      --primary: #0f766e;       /* Hijau Toska Sains */
      --primary-dark: #115e59;
      --primary-light: #ccfbf1;
      --secondary: #0369a1;     /* Biru Ilmiah */
      --secondary-dark: #075985;
      --secondary-light: #e0f2fe;
      --accent: #d97706;        /* Kuning Emas Aksen */
      --accent-light: #fef3c7;
      --success: #15803d;
      --success-light: #dcfce7;
      --danger: #b91c1c;
      --danger-light: #fee2e2;
      --bg-body: #f0f9ff;
      --bg-card: #ffffff;
      --text-main: #0f172a;
      --text-muted: #475569;
      --border-color: #cbd5e1;
      --shadow-sm: 0 2px 6px rgba(15, 23, 42, 0.06);
      --shadow-md: 0 8px 20px rgba(15, 23, 42, 0.08);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-sans);
      background: linear-gradient(135deg, #ecfdf5 0%, #e0f2fe 50%, #f8fafc 100%);
      color: var(--text-main);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
    }

    /* ==========================================================================
       HEADER & PROGRESS BAR GLOBAL
       ========================================================================== */
    header.app-header {
      background: linear-gradient(90deg, var(--primary-dark), var(--secondary-dark));
      color: #ffffff;
      padding: 12px 20px;
      box-shadow: var(--shadow-md);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-top {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .brand-box {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-logo {
      width: 42px;
      height: 42px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .brand-title h1 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.2px;
    }

    .brand-title p {
      font-size: 0.8rem;
      color: #bae6fd;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .student-badge {
      background: rgba(255, 255, 255, 0.16);
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .btn-icon {
      background: rgba(255, 255, 255, 0.15);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.3);
      padding: 7px 12px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-icon:hover {
      background: rgba(255, 255, 255, 0.28);
      transform: translateY(-1px);
    }

    .progress-wrapper {
      max-width: 1280px;
      margin: 10px auto 0;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 0.8rem;
    }

    .progress-track {
      flex: 1;
      height: 8px;
      background: rgba(255, 255, 255, 0.2);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #34d399, #fbbf24);
      border-radius: 999px;
      transition: width 0.4s ease;
    }

    /* ==========================================================================
       LAYOUT UTAMA (SIDEBAR + KONTEN)
       ========================================================================== */
    .app-container {
      max-width: 1280px;
      width: 100%;
      margin: 20px auto;
      padding: 0 16px;
      display: grid;
      grid-template-columns: 270px 1fr;
      gap: 20px;
      flex: 1;
    }

    @media (max-width: 960px) {
      .app-container {
        grid-template-columns: 1fr;
      }
    }

    /* Sidebar Navigasi */
    aside.sidebar {
      background: var(--bg-card);
      border-radius: var(--radius-md);
      padding: 16px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-color);
      height: fit-content;
      position: sticky;
      top: 96px;
    }

    @media (max-width: 960px) {
      aside.sidebar {
        position: static;
      }
    }

    .sidebar-title {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      font-weight: 700;
      margin-bottom: 10px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--border-color);
    }

    .nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .nav-btn {
      width: 100%;
      text-align: left;
      background: transparent;
      border: 1px solid transparent;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-main);
      transition: all 0.2s ease;
    }

    .nav-btn:hover {
      background: var(--secondary-light);
      color: var(--secondary-dark);
    }

    .nav-btn.active {
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      color: #ffffff;
      box-shadow: var(--shadow-sm);
    }

    .nav-syntax {
      display: block;
      font-size: 0.72rem;
      font-weight: 500;
      opacity: 0.85;
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #cbd5e1;
      flex-shrink: 0;
    }

    .status-dot.done {
      background: #22c55e;
      box-shadow: 0 0 0 3px #dcfce7;
    }

    .nav-btn.active .status-dot.done {
      background: #fde047;
      box-shadow: 0 0 0 3px rgba(253, 224, 71, 0.3);
    }

    /* Area Konten Utama */
    main.content-area {
      background: var(--bg-card);
      border-radius: var(--radius-md);
      padding: 24px;
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-color);
      min-height: 560px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    @media (max-width: 600px) {
      main.content-area {
        padding: 16px;
      }
    }

    .module-section {
      display: none;
      animation: fadeIn 0.35s ease;
    }

    .module-section.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ==========================================================================
       KOMPONEN UI UMUM (BADGE, CARD, BUTTON, ALERT BOX)
       ========================================================================== */
    .discovery-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--accent-light);
      color: #92400e;
      border: 1px solid #fcd34d;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .module-header {
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 2px solid #f1f5f9;
    }

    .module-header h2 {
      font-size: 1.55rem;
      color: var(--primary-dark);
      margin-bottom: 6px;
    }

    .module-header p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .card {
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 18px;
      margin-bottom: 16px;
    }

    .card-white {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 18px;
      box-shadow: var(--shadow-sm);
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 768px) {
      .grid-2, .grid-3 {
        grid-template-columns: 1fr;
      }
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: var(--radius-sm);
      font-size: 0.92rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-primary {
      background: var(--primary);
      color: #ffffff;
    }

    .btn-primary:hover:not(:disabled) {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: var(--secondary);
      color: #ffffff;
    }

    .btn-secondary:hover:not(:disabled) {
      background: var(--secondary-dark);
    }

    .btn-accent {
      background: var(--accent);
      color: #ffffff;
    }

    .btn-accent:hover:not(:disabled) {
      background: #b45309;
    }

    .btn-outline {
      background: #ffffff;
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-outline:hover:not(:disabled) {
      background: #f1f5f9;
    }

    .feedback-box {
      padding: 14px 16px;
      border-radius: var(--radius-sm);
      margin-top: 12px;
      font-size: 0.92rem;
      display: none;
    }

    .feedback-box.show {
      display: block;
      animation: fadeIn 0.25s ease;
    }

    .feedback-success {
      background: var(--success-light);
      color: #14532d;
      border: 1px solid #86efac;
    }

    .feedback-error {
      background: var(--danger-light);
      color: #7f1d1d;
      border: 1px solid #fca5a5;
    }

    .feedback-info {
      background: var(--secondary-light);
      color: #0c4a6e;
      border: 1px solid #7dd3fc;
    }

    /* Footer Navigasi Bawah Modul */
    .module-footer-nav {
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    /* ==========================================================================
       HALAMAN BERANDA / PEMBUKA
       ========================================================================== */
    .hero-banner {
      background: linear-gradient(135deg, #0f766e 0%, #0369a1 100%);
      color: #ffffff;
      border-radius: var(--radius-lg);
      padding: 28px;
      margin-bottom: 20px;
      position: relative;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 20px;
      align-items: center;
    }

    @media (max-width: 768px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
    }

    .hero-banner h1 {
      font-size: 2rem;
      line-height: 1.2;
      margin: 10px 0;
    }

    .school-pill {
      display: inline-block;
      background: rgba(255, 255, 255, 0.2);
      padding: 4px 12px;
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .name-input-box {
      background: rgba(255, 255, 255, 0.95);
      color: var(--text-main);
      padding: 16px;
      border-radius: var(--radius-md);
      margin-top: 16px;
    }

    .input-row {
      display: flex;
      gap: 10px;
      margin-top: 8px;
      flex-wrap: wrap;
    }

    .input-field {
      flex: 1;
      min-width: 200px;
      padding: 10px 14px;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-family: inherit;
    }

    .input-field:focus {
      outline: 2px solid var(--primary);
      border-color: transparent;
    }

    .journey-steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }

    .journey-card {
      background: #ffffff;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 12px;
      cursor: pointer;
      transition: transform 0.2s, border-color 0.2s;
    }

    .journey-card:hover {
      transform: translateY(-2px);
      border-color: var(--primary);
    }

    /* ==========================================================================
       MODUL 1: PETA KONSEP INTERAKTIF
       ========================================================================== */
    .concept-map-container {
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px;
      overflow-x: auto;
    }

    .concept-node {
      cursor: pointer;
      transition: transform 0.2s ease, filter 0.2s ease;
    }

    .concept-node:hover {
      filter: brightness(1.06);
    }

    .concept-node.selected rect, .concept-node.selected ellipse {
      stroke: #f59e0b;
      stroke-width: 3.5px;
    }

    /* ==========================================================================
       MODUL 2: STRUKTUR SEL BAKTERI (SVG INTERAKTIF + ANIMASI FLAGELA)
       ========================================================================== */
    @keyframes waveFlagella {
      0% { transform: skewY(0deg) scaleX(1); }
      25% { transform: skewY(4deg) scaleX(0.97); }
      50% { transform: skewY(0deg) scaleX(1.02); }
      75% { transform: skewY(-4deg) scaleX(0.97); }
      100% { transform: skewY(0deg) scaleX(1); }
    }

    .flagella-anim {
      transform-origin: 540px 180px;
      animation: waveFlagella 1.8s infinite ease-in-out;
    }

    .cell-hotspot {
      cursor: pointer;
      transition: opacity 0.2s;
    }

    .cell-hotspot:hover {
      opacity: 0.85;
    }

    .organelle-chip {
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: #ffffff;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    .organelle-chip.explored {
      background: var(--success-light);
      border-color: #4ade80;
      color: #14532d;
    }

    .organelle-chip.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary-dark);
    }

    /* ==========================================================================
       MODUL 3: BENTUK & SUSUNAN BAKTERI + GAME MENCOCOKKAN
       ========================================================================== */
    .shape-gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }

    .shape-card {
      background: #ffffff;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 12px;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .shape-card:hover {
      border-color: var(--secondary);
      transform: translateY(-2px);
    }

    .shape-card.active {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    /* ==========================================================================
       MODUL 4: SIMULASI REPRODUKSI & TRANSFER GEN HORIZONTAL
       ========================================================================== */
    .sim-stage-box {
      background: #0f172a;
      color: #f8fafc;
      border-radius: var(--radius-md);
      padding: 16px;
      margin-bottom: 14px;
    }

    .tab-bar {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      flex-wrap: wrap;
    }

    .tab-btn {
      padding: 9px 16px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-color);
      background: #f1f5f9;
      font-weight: 600;
      cursor: pointer;
      color: var(--text-main);
    }

    .tab-btn.active {
      background: var(--secondary);
      color: #ffffff;
      border-color: var(--secondary-dark);
    }

    .formula-box {
      background: var(--secondary-light);
      border: 1px solid #7dd3fc;
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      color: var(--secondary-dark);
      text-align: center;
      font-size: 1.05rem;
    }

    /* ==========================================================================
       MODUL 5: DRAG & DROP KLASIFIKASI (TOUCH + MOUSE FRIENDLY)
       ========================================================================== */
    .dnd-pool {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      min-height: 90px;
      padding: 14px;
      background: #f1f5f9;
      border: 2px dashed #94a3b8;
      border-radius: var(--radius-md);
      margin-bottom: 16px;
    }

    .dnd-card {
      background: #ffffff;
      border: 2px solid var(--secondary);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      font-size: 0.85rem;
      cursor: grab;
      user-select: none;
      touch-action: manipulation;
      box-shadow: var(--shadow-sm);
      max-width: 260px;
      transition: transform 0.15s, box-shadow 0.15s;
    }

    .dnd-card:active {
      cursor: grabbing;
    }

    .dnd-card.selected-touch {
      border-color: var(--accent);
      background: var(--accent-light);
      transform: scale(1.03);
    }

    .dnd-card.correct {
      border-color: var(--success);
      background: var(--success-light);
    }

    .dnd-card.wrong {
      border-color: var(--danger);
      background: var(--danger-light);
    }

    .dropzone {
      min-height: 220px;
      border: 2px dashed var(--primary);
      border-radius: var(--radius-md);
      padding: 14px;
      background: #f0fdf4;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: background 0.2s;
    }

    .dropzone.eubacteria-zone {
      border-color: var(--secondary);
      background: #f0f9ff;
    }

    .dropzone.drag-over {
      background: #fef9c3;
      border-style: solid;
    }

    /* ==========================================================================
       MODUL 6: KUIS INTERAKTIF
       ========================================================================== */
    .quiz-option {
      display: block;
      width: 100%;
      text-align: left;
      padding: 12px 16px;
      margin-bottom: 10px;
      border: 2px solid var(--border-color);
      border-radius: var(--radius-sm);
      background: #ffffff;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.2s;
    }

    .quiz-option:hover {
      border-color: var(--secondary);
      background: var(--secondary-light);
    }

    .quiz-option.selected {
      border-color: var(--primary);
      background: var(--primary-light);
      font-weight: 600;
    }

    .match-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      align-items: center;
      padding: 10px;
      background: #f8fafc;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      margin-bottom: 8px;
    }

    @media (max-width: 600px) {
      .match-row {
        grid-template-columns: 1fr;
      }
    }

    /* ==========================================================================
       MODAL (PETUNJUK, GLOSARIUM, REFERENSI)
       ========================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.65);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 999;
    }

    .modal-backdrop.open {
      display: flex;
      animation: fadeIn 0.2s ease;
    }

    .modal-box {
      background: #ffffff;
      border-radius: var(--radius-md);
      max-width: 680px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      padding: 24px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 16px;
    }

    .glossary-item {
      padding: 10px 0;
      border-bottom: 1px solid #f1f5f9;
    }

    .glossary-item strong {
      color: var(--primary-dark);
    }

    footer.app-footer {
      text-align: center;
      padding: 16px;
      font-size: 0.82rem;
      color: var(--text-muted);
      background: #ffffff;
      border-top: 1px solid var(--border-color);
      margin-top: 24px;
    }
  </style>
</head>
<body>

  <!-- ========================================================================
       HEADER APLIKASI & PROGRESS BAR
       ======================================================================== -->
  <header class="app-header">
    <div class="header-top">
      <div class="brand-box">
        <div class="brand-logo" aria-hidden="true">
          <!-- Ikon Bakteri SVG Inline -->
          <svg width="28" height="28" viewBox="0 0 64 64" fill="none">
            <rect x="14" y="20" width="36" height="24" rx="12" fill="#34d399" stroke="#ffffff" stroke-width="3"/>
            <path d="M50 32C55 28 58 36 62 32" stroke="#fde047" stroke-width="3" stroke-linecap="round"/>
            <circle cx="25" cy="32" r="3" fill="#064e3b"/>
            <path d="M32 28C35 26 38 38 41 32" stroke="#064e3b" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div class="brand-title">
          <h1>Jelajah Dunia Monera</h1>
          <p>Biologi Kelas X SMA &bull; SMAN 2 Tanjung Raja</p>
        </div>
      </div>

      <div class="header-actions">
