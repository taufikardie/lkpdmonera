              </div>
              <div>
                <label for="sliderGen" style="font-weight:700; font-size:0.9rem;">Jumlah Generasi (n): <span id="valGen" style="color:var(--secondary);">3</span> generasi (<span id="valMinutes">60</span> menit)</label>
                <input type="range" id="sliderGen" min="0" max="10" value="3" style="width:100%; margin-top:6px;" oninput="updatePopulationCalc()"/>
              </div>
            </div>

