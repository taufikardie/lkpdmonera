        <!-- BAGIAN A: SIMULASI PEMBELAHAN BINER -->
        <div id="mod4PanelBiner">
          <div class="sim-stage-box">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:10px;">
              <strong style="color:#34d399;" id="binerStageTitle">Tahap 1: Sel Bakteri Induk Siap Membelah</strong>
              <span style="font-size:0.85rem; background:rgba(255,255,255,0.12); padding:4px 10px; border-radius:999px;" id="binerStepIndicator">Langkah 1 / 5</span>
            </div>

            <!-- Kanvas SVG Animasi 5 Tahap Pembelahan Biner -->
            <svg id="binerSvgStage" viewBox="0 0 600 180" width="100%" style="background:#1e293b; border-radius:10px; display:block;"></svg>

            <p id="binerStageDesc" style="margin-top:10px; font-size:0.9rem; color:#e2e8f0;">
              Sel bakteri dewasa memiliki satu kromosom sirkuler (DNA) yang menempel pada membran plasma dan siap menggandakan diri.
            </p>
          </div>

          <!-- Kontrol Animasi Pembelahan Biner -->
          <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px;">
            <button class="btn btn-primary" onclick="startBinerAnim()">&#9654; Mulai Animasi</button>
            <button class="btn btn-accent" onclick="pauseBinerAnim()">&#10074;&#10074; Jeda</button>
            <button class="btn btn-secondary" onclick="stepBinerAnim()">Langkah Berikutnya &rarr;</button>
            <button class="btn btn-outline" onclick="resetBinerAnim()">&#8634; Ulangi / Reset</button>
          </div>

          <!-- Kalkulator & Visualisasi Populasi N = N0 * 2^n -->
          <div class="card">
            <h3 style="color:var(--primary-dark); margin-bottom:8px;">Simulasi Pertumbuhan Eksponensial Populasi Bakteri</h3>
            <p style="font-size:0.9rem; color:var(--text-muted); margin-bottom:12px;">
              Geser pengatur <strong>Jumlah Sel Awal (N&#8320;)</strong> dan <strong>Jumlah Generasi (n)</strong> untuk mengamati ledakan jumlah sel bakteri!
            </p>

            <div class="grid-2" style="margin-bottom:12px;">
              <div>
                <label for="sliderN0" style="font-weight:700; font-size:0.9rem;">Jumlah Bakteri Awal (N&#8320;): <span id="valN0" style="color:var(--primary);">1</span> sel</label>
