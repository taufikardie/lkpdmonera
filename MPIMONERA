    function selectConcept(key) {
      const data = conceptData[key];
      if (!data) return;

      document.querySelectorAll('.concept-node').forEach(n => n.classList.remove('selected'));
      const nodeEl = document.getElementById('node-' + key);
      if (nodeEl) nodeEl.classList.add('selected');

      document.getElementById('conceptTitle').textContent = data.title;
      document.getElementById('conceptDesc').textContent = data.desc;
      document.getElementById('conceptKeyPoints').innerHTML =
        '<strong>Poin Penting:</strong><ul style="padding-left:18px; margin-top:4px;">' +
        data.points.map(p => '<li>' + p + '</li>').join('') + '</ul>';

      if (!appState.exploredConcepts.includes(key)) {
        appState.exploredConcepts.push(key);
        const count = Math.min(appState.exploredConcepts.length, 8);
        document.getElementById('mod1ClickedCount').textContent = count;
        if (count >= 6) {
          appState.completedModules.mod1 = true;
        }
        saveState();
      }
    }

