    function inspectOrganelle(id) {
      const item = organelleData.find(o => o.id === id);
      if (!item) return;

      document.querySelectorAll('.organelle-chip').forEach(c => c.classList.remove('active'));
      const chip = document.getElementById('chip-' + id);
      if (chip) chip.classList.add('active');

      document.getElementById('orgStatusBadge').textContent = 'Struktur #' + item.num;
      document.getElementById('orgTitle').textContent = item.num + '. ' + item.name;
      document.getElementById('orgDesc').textContent = item.desc;
      document.getElementById('orgFunc').textContent = item.func;
      document.getElementById('orgExtraNote').textContent = item.note;

      if (!appState.exploredOrganelles.includes(id)) {
        appState.exploredOrganelles.push(id);
        renderOrganelleChips();
        const activeChip = document.getElementById('chip-' + id);
        if (activeChip) activeChip.classList.add('active');
      }

      if (appState.exploredOrganelles.length === organelleData.length) {
        document.getElementById('mod2CompleteBanner').classList.add('show');
        appState.completedModules.mod2 = true;
        saveState();
      }
