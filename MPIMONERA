    let currentQuizIdx = 0;
    let userQuizAnswers = new Array(quizQuestions.length).fill(null);

    function renderQuizQuestion() {
      const qObj = quizQuestions[currentQuizIdx];
      document.getElementById('quizQuestionCounter').textContent = `Soal ${currentQuizIdx + 1} dari ${quizQuestions.length}`;
      document.getElementById('quizQuestionTypeBadge').textContent = qObj.type;
      document.getElementById('quizWarningBox').classList.remove('show');

      const body = document.getElementById('quizQuestionBody');
      if (qObj.type !== 'Menjodohkan') {
        const optsHtml = qObj.options.map((opt, i) => {
          const isSel = userQuizAnswers[currentQuizIdx] === i;
          const letter = String.fromCharCode(65 + i);
          return `<button class="quiz-option ${isSel ? 'selected' : ''}" onclick="selectQuizAnswer(${i})">
            <strong>${letter}.</strong> ${opt}
          </button>`;
        }).join('');

        body.innerHTML = `
          <p style="font-size:1.02rem; font-weight:600; margin-bottom:12px;">${qObj.q}</p>
          ${qObj.svg ? qObj.svg : ''}
          <div style="margin-top:8px;">${optsHtml}</div>
        `;
      } else {
        const choicesHtml = qObj.choices.map((ch, i) =>
          `<option value="${i}" ${userQuizAnswers[currentQuizIdx] === i ? 'selected' : ''}>${ch}</option>`
        ).join('');

        body.innerHTML = `
          <p style="font-size:1rem; font-weight:600; margin-bottom:12px;">${qObj.q}</p>
          <div class="match-row">
            <div style="font-weight:700; color:var(--primary-dark);">${qObj.left}</div>
            <div>
              <select class="input-field" style="width:100%;" onchange="selectQuizAnswer(parseInt(this.value, 10))">
                <option value="">-- Pilih Pasangan yang Tepat --</option>
                ${choicesHtml}
              </select>
            </div>
          </div>
        `;
      }

      // Update tombol navigasi
      document.getElementById('btnQuizPrev').disabled = currentQuizIdx === 0;
      const isLast = currentQuizIdx === quizQuestions.length - 1;
      document.getElementById('btnQuizNext').style.display = isLast ? 'none' : 'inline-flex';
      document.getElementById('btnQuizSubmit').style.display = isLast ? 'inline-flex' : 'none';

      renderQuizNumberDots();
    }

    function selectQuizAnswer(val) {
      userQuizAnswers[currentQuizIdx] = isNaN(val) ? null : val;
      renderQuizQuestion();
    }

    function renderQuizNumberDots() {
      const container = document.getElementById('quizNumberDots');
      container.innerHTML = quizQuestions.map((_, idx) => {
        const answered = userQuizAnswers[idx] !== null;
        const active = idx === currentQuizIdx;
        let bg = '#f1f5f9';
        let color = '#0f172a';
        let border = '1px solid #cbd5e1';
        if (answered) { bg = '#dcfce7'; color = '#14532d'; border = '1px solid #4ade80'; }
        if (active) { bg = '#0369a1'; color = '#ffffff'; border = '1px solid #075985'; }

        return `<button onclick="jumpQuizQuestion(${idx})" style="width:30px; height:30px; border-radius:6px; background:${bg}; color:${color}; border:${border}; font-size:0.8rem; font-weight:700; cursor:pointer;">${idx + 1}</button>`;
      }).join('');
    }

    function jumpQuizQuestion(idx) {
      currentQuizIdx = idx;
      renderQuizQuestion();
    }

    function prevQuizQuestion() {
      if (currentQuizIdx > 0) {
        currentQuizIdx--;
        renderQuizQuestion();
      }
    }

    function nextQuizQuestion() {
      if (currentQuizIdx < quizQuestions.length - 1) {
        currentQuizIdx++;
        renderQuizQuestion();
      }
    }

    function submitFinalQuiz() {
      const unanswered = userQuizAnswers.filter(a => a === null).length;
      const warn = document.getElementById('quizWarningBox');
      if (unanswered > 0) {
        warn.classList.add('show');
        warn.innerHTML = `Masih terdapat <strong>${unanswered} soal</strong> yang belum dijawab. Klik nomor soal berwarna abu-abu di atas untuk melengkapinya sebelum mengakhiri kuis!`;
        return;
      }

      let score = 0;
      quizQuestions.forEach((q, idx) => {
        if (userQuizAnswers[idx] === q.ans) score++;
      });

      const pct = Math.round((score / quizQuestions.length) * 100);
      let category = '';
      if (pct >= 86) category = 'Sangat Baik (Istimewa - Menguasai Konsep Monera)';
      else if (pct >= 75) category = 'Baik (Tuntas Kriteria Ketercapaian Tujuan Pembelajaran)';
      else if (pct >= 60) category = 'Cukup (Perlu Penguatan pada Beberapa Sub-Materi)';
      else category = 'Perlu Bimbingan (Silakan Eksplorasi Ulang Modul 1-6)';

      document.getElementById('quizActiveContainer').style.display = 'none';
      document.getElementById('quizResultContainer').style.display = 'block';

      const sName = appState.studentName || 'Peserta Didik Kelas X';
      document.getElementById('resultStudentLabel').textContent = sName + ' &bull; SMAN 2 Tanjung Raja';
      document.getElementById('resultScoreBig').textContent = `${score} / ${quizQuestions.length} (${pct}%)`;
      document.getElementById('resultCategoryBadge').textContent = 'Kategori: ' + category;

      // Render Pembahasan Lengkap
      const reviewList = document.getElementById('quizReviewList');
      reviewList.innerHTML = quizQuestions.map((q, idx) => {
        const uAns = userQuizAnswers[idx];
        const isCorrect = uAns === q.ans;
        const optList = q.type === 'Menjodohkan' ? q.choices : q.options;
        const userText = optList[uAns];
        const correctText = optList[q.ans];

        return `
          <div style="padding:12px; border-radius:8px; margin-bottom:10px; border:1px solid ${isCorrect ? '#86efac' : '#fca5a5'}; background:${isCorrect ? '#f0fdf4' : '#fef2f2'};">
            <div style="font-weight:700; font-size:0.92rem; margin-bottom:4px;">
              Soal ${idx + 1} (${q.type}): ${isCorrect ? '<span style="color:var(--success);">&#10003; Benar</span>' : '<span style="color:var(--danger);">&#10007; Kurang Tepat</span>'}
            </div>
            <p style="font-size:0.88rem; margin-bottom:6px;">${q.type === 'Menjodohkan' ? q.left : q.q}</p>
            <div style="font-size:0.85rem;">
              <div><strong>Jawaban Kamu:</strong> ${userText}</div>
              ${!isCorrect ? `<div style="color:var(--success);"><strong>Kunci Jawaban:</strong> ${correctText}</div>` : ''}
              <div style="margin-top:4px; color:var(--text-muted);"><strong>Pembahasan:</strong> ${q.explain}</div>
            </div>
          </div>
        `;
      }).join('');

      appState.quizScore = pct;
      appState.completedModules.mod6 = true;
      saveState();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function restartQuiz() {
      currentQuizIdx = 0;
      userQuizAnswers = new Array(quizQuestions.length).fill(null);
      document.getElementById('quizResultContainer').style.display = 'none';
      document.getElementById('quizActiveContainer').style.display = 'block';
      renderQuizQuestion();
    }

    /* ========================================================================
       10. GLOSARIUM ISTILAH BIOLOGI
       ======================================================================== */
    const glossaryTerms = [
      { term: 'Archaebacteria', def: 'Kelompok mikroorganisme prokariotik purba yang dinding selnya tidak mengandung peptidoglikan dan mampu hidup di habitat ekstrem.' },
      { term: 'Bakteriofag', def: 'Virus yang secara spesifik menginfeksi dan bereplikasi di dalam sel bakteri; berperan sebagai vektor pada proses transduksi.' },
      { term: 'Endospora', def: 'Struktur dorman berdinding tebal yang dibentuk oleh beberapa bakteri (seperti Bacillus dan Clostridium) untuk bertahan pada kondisi lingkungan tidak menguntungkan.' },
      { term: 'Eubacteria', def: 'Kelompok bakteri sejati yang memiliki dinding sel tersusun atas peptidoglikan dan hidup secara kosmopolit.' },
      { term: 'Fiksasi Nitrogen', def: 'Proses pengikatan gas nitrogen bebas (N2) dari atmosfer menjadi amonia atau senyawa nitrogen yang dapat diserap tumbuhan.' },
      { term: 'Kapsul', def: 'Lapisan polisakarida kental di bagian terluar sel bakteri tertentu yang melindungi dari kekeringan dan sistem imun inang.' },
      { term: 'Konjugasi', def: 'Transfer materi genetik (plasmid) secara langsung antara dua sel bakteri melalui jembatan sitoplasma yang dibentuk pilus seks.' },
      { term: 'Nukleoid', def: 'Daerah tidak bermembran di dalam sitoplasma prokariotik tempat terkonsentrasinya kromosom DNA sirkuler.' },
      { term: 'Pembelahan Biner', def: 'Reproduksi aseksual pada prokariota di mana satu sel induk membelah langsung menjadi dua sel anak yang identik secara genetik.' },
      { term: 'Peptidoglikan', def: 'Polimer gabungan gula dan asam amino yang membentuk struktur jaring kaku pada dinding sel Eubacteria.' },
      { term: 'Plasmid', def: 'Molekul DNA sirkuler kecil ekstrakromosomal di dalam sel bakteri yang mampu bereplikasi secara mandiri.' },
      { term: 'Prokariotik', def: 'Tipe sel yang tidak memiliki membran pembungkus inti sel (karioteka) maupun organel bermembran rangkap.' },
      { term: 'Transduksi', def: 'Perpindahan fragmen DNA bakteri dari satu sel ke sel lainnya dengan perantaraan virus bakteriofag.' },
      { term: 'Transformasi', def: 'Pengambilan fragmen DNA telanjang (bebas) dari lingkungan sekitar oleh sel bakteri kompeten.' }
    ];

    function renderGlossary() {
      const box = document.getElementById('glossaryContent');
      box.innerHTML = glossaryTerms.map(g =>
        `<div class="glossary-item"><strong>${g.term}:</strong> ${g.def}</div>`
      ).join('');
    }

