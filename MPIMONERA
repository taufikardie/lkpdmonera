          </div>

          <div class="tab-bar">
            <button class="btn btn-secondary" id="btnMechTransf" onclick="selectTransferMech('transformasi')">1. Transformasi</button>
            <button class="btn btn-outline" id="btnMechTransd" onclick="selectTransferMech('transduksi')">2. Transduksi</button>
